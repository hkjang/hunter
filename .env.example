# Copy this file to .env and protect it with chmod 600 .env.
# PostgreSQL is supplied by your organization; it is not bundled in the release.
POSTGRES_DSN=postgres://hunter:CHANGE_ME@postgres.internal:5432/hunter?sslmode=verify-full
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
# Generate once: openssl rand -base64 32
# Preserve this key with encrypted backups. Do not replace it on an existing DB.
ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
